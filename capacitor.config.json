{
  "appId": "com.warecovery.pro",
  "appName": "WA Recovery Pro",
  "webDir": "dist",
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#0a0f1c"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#0a0f1c",
      "showSpinner": false
    },
    "StatusBar": {
      "backgroundColor": "#0a0f1c",
      "style": "DARK"
    },
    "LocalNotifications": {
      "smallIcon": "ic_notification",
      "iconColor": "#25D366"
    }
  }
}
