{
  "java.errors.incompleteClasspath.severity": "ignore",
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.import.gradle.enabled": true,
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.gradle/**"
  ],
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "android/.gradle": true,
    "android/app/build": true
  }
}
